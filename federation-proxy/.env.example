# ─── Required ────────────────────────────────────────────────────────────────

# A strong random token that ClawDeck Hub will use to authenticate
# Generate one: openssl rand -hex 32
FEDERATION_TOKEN=your-federation-token-here

# Your local OpenClaw Gateway URL (usually localhost, never exposed externally)
GATEWAY_URL=http://host.docker.internal:18789

# Your local OpenClaw Gateway Token (from ~/.openclaw/openclaw.json)
GATEWAY_TOKEN=your-openclaw-gateway-token-here

# ─── Optional ────────────────────────────────────────────────────────────────

# Port to listen on (default: 18790)
PROXY_PORT=18790

# Bind host (default: 0.0.0.0 = all interfaces)
# Set to your Tailscale IP to only accept Tailscale connections:
# BIND_HOST=100.x.x.x
BIND_HOST=0.0.0.0

# IP Allowlist: comma-separated IPs or CIDR ranges
# Leave empty to allow all (not recommended for production)
# Tailscale range: 100.64.0.0/10
ALLOWED_IPS=100.64.0.0/10

# Rate limit: max requests per minute per IP (default: 120)
RATE_LIMIT_RPM=120

# Audit log: write all requests to /app/logs/audit.jsonl (default: true)
AUDIT_LOG=true
